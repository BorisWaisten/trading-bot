ALPACA_API_KEY=tu_key_aqui
ALPACA_SECRET_KEY=tu_secret_aqui

# false (default) = paper trading, dinero simulado. true = cuenta REAL con
# las claves de arriba -- leer tradingbot/config.py y CHECKLIST_PRODUCCION.md
# antes de activarlo.
ALPACA_LIVE_TRADING=false

# Binance Futures Testnet (https://testnet.binancefuture.com/) -- NO son las
# API keys de tu cuenta real de Binance.
BINANCE_API_KEY=tu_key_de_testnet
BINANCE_API_SECRET=tu_secret_de_testnet
# true (default) = testnet, dinero simulado. false = cuenta REAL (con API
# keys reales de binance.com arriba) -- leer tradingbot/binance_config.py
# y CHECKLIST_PRODUCCION.md antes de activarlo.
BINANCE_TESTNET=true

# Solo necesario si desplegas el dashboard en una URL publica (ej. Railway):
# clave que va a pedir el panel antes de mostrar cuentas/posiciones.
DASHBOARD_PASSWORD=

# Opcional: que bots levanta run_all.py en Railway (separados por coma).
# Por defecto levanta los tres:
# tradingbot.bots.bot,tradingbot.bots.swing_bot,tradingbot.bots.binance_grid_bot
RAILWAY_BOTS=
