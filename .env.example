ALPACA_API_KEY=tu_key_aqui
ALPACA_SECRET_KEY=tu_secret_aqui

# Binance Futures Testnet (https://testnet.binancefuture.com/) -- NO son las
# API keys de tu cuenta real de Binance.
BINANCE_API_KEY=tu_key_de_testnet
BINANCE_API_SECRET=tu_secret_de_testnet
BINANCE_TESTNET=true

# Solo necesario si desplegas el dashboard en una URL publica (ej. Railway):
# clave que va a pedir el panel antes de mostrar cuentas/posiciones.
DASHBOARD_PASSWORD=

# Opcional: que bots levanta run_all.py en Railway (separados por coma).
# Por defecto levanta los tres: bot.py,swing_bot.py,binance_grid_bot.py
RAILWAY_BOTS=
